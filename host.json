{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "durableTask": {
      "hubName": "PdfProcessingHub",
      "storageProvider": {
        "type": "AzureStorage"
      }
    }
  },
  "logging": {
    "logLevel": {
      "DurableTask": "Warning",
      "Function": "Information"
    }
  },
  "functionTimeout": "00:10:00"
}
